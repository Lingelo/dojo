#!/bin/sh
# Kaizen git hook (audit fix git_hooks): refuses a push of a branch whose pushed commit has no recorded review,
# like the Claude Code gate, even when Claude Code runs without the Kaizen plugin.
# Finds the Kaizen CLI (git config kaizen.cli, then $KAIZEN_CLI, then the newest kaizen of the dojo
# marketplace in the Claude Code plugin cache) and refuses when it cannot: an opted-in guard rail never
# disappears silently. Inactive outside a Kaizen repo (.kaizen/config.json).
cli=$(node -e 'const fs=require("fs"),p=require("path"),os=require("os"),cp=require("child_process");const file=(f)=>{try{return fs.statSync(f).isFile()}catch{return false}};let c="";try{c=cp.execFileSync("git",["config","--get","kaizen.cli"],{encoding:"utf8",stdio:["ignore","pipe","ignore"]}).trim()}catch{}if(!c)c=process.env.KAIZEN_CLI||"";if(!c){const d=p.join(process.env.CLAUDE_CONFIG_DIR||p.join(os.homedir(),".claude"),"plugins","cache","dojo","kaizen");let vs=[];try{vs=fs.readdirSync(d).filter((v)=>/^\d+\.\d+\.\d+$/.test(v))}catch{}vs.sort((a,b)=>{const x=a.split(".").map(Number),y=b.split(".").map(Number);return y[0]-x[0]||y[1]-x[1]||y[2]-x[2]});for(const v of vs){try{const m=JSON.parse(fs.readFileSync(p.join(d,v,".claude-plugin","plugin.json"),"utf8"));const k=p.join(d,v,"scripts","kaizen.mjs");if(m.name==="kaizen"&&file(k)){c=k;break}}catch{}}}if(!c||!file(c)){process.stderr.write("[kaizen] git hook: Kaizen CLI not found (git config kaizen.cli, $KAIZEN_CLI, or the kaizen@dojo plugin in the Claude Code plugin cache). Enable the plugin, or point to it: git config kaizen.cli <path>/scripts/kaizen.mjs\n");process.exit(1)}process.stdout.write(c)') || exit 1
exec node "$cli" githook pre-push "$@"
