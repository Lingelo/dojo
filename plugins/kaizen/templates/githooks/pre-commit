#!/bin/sh
# Kaizen git hook (audit fix git_hooks): refuses a commit whose staged changes carry a key or token,
# like the Claude Code gate, even when Claude Code runs without the Kaizen plugin.
# Finds the Kaizen CLI (git config kaizen.cli, then $KAIZEN_CLI, then the newest kaizen of the dojo
# marketplace in the Claude Code plugin cache; each must be Kaizen core by its plugin.json) and refuses when
# it cannot: an explicit pointer that is wrong is never replaced, and an opted-in guard rail never disappears
# silently. Same lookup as the kaizen-ops resolver minus its sibling checkout (parity test in kaizen-ops).
# Inactive outside a Kaizen repo (.kaizen/config.json).
cli=$(node -e 'const fs=require("fs"),p=require("path"),os=require("os"),cp=require("child_process");const core=(k)=>{try{return fs.statSync(k).isFile()&&JSON.parse(fs.readFileSync(p.join(p.dirname(k),"..",".claude-plugin","plugin.json"),"utf8")).name==="kaizen"}catch{return false}};let c="",s="";try{c=cp.execFileSync("git",["config","--get","kaizen.cli"],{encoding:"utf8",stdio:["ignore","pipe","ignore"]}).trim()}catch{}if(c)s="git config kaizen.cli";else if(process.env.KAIZEN_CLI){c=process.env.KAIZEN_CLI;s="KAIZEN_CLI"}if(c&&!core(c)){process.stderr.write("[kaizen] git hook: "+s+" points to "+c+", which is not the scripts/kaizen.mjs of Kaizen core (its plugin.json must name kaizen). Fix it: git config kaizen.cli <path>/scripts/kaizen.mjs\n");process.exit(1)}if(!c){const d=p.join(process.env.CLAUDE_CONFIG_DIR||p.join(os.homedir(),".claude"),"plugins","cache","dojo","kaizen");let vs=[];try{vs=fs.readdirSync(d).filter((v)=>/^\d+\.\d+\.\d+$/.test(v))}catch{}vs.sort((a,b)=>{const x=a.split(".").map(Number),y=b.split(".").map(Number);return y[0]-x[0]||y[1]-x[1]||y[2]-x[2]});for(const v of vs){const k=p.join(d,v,"scripts","kaizen.mjs");if(core(k)){c=k;break}}}if(!c){process.stderr.write("[kaizen] git hook: Kaizen CLI not found (git config kaizen.cli, $KAIZEN_CLI, or the kaizen@dojo plugin in the Claude Code plugin cache). Enable the plugin, or point to it: git config kaizen.cli <path>/scripts/kaizen.mjs\n");process.exit(1)}process.stdout.write(c)') || exit 1
exec node "$cli" githook pre-commit "$@"
