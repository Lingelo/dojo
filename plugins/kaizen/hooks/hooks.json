{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/review-hooks.mjs\" --heartbeat", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/secret-gate.mjs\"", "timeout": 30 }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/review-gate.mjs\"", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/post-edit.mjs\"", "timeout": 15 }
        ]
      },
      {
        "matcher": "Agent|Task|Skill",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/review-hooks.mjs\" --evidence", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/quality-gate.mjs\"", "timeout": 900 },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/review-hooks.mjs\" --stop", "timeout": 15 },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ledger-hook.mjs\"", "timeout": 30 }
        ]
      }
    ]
  }
}
