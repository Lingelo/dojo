{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/dump.mjs\" --host codex --event SessionStart --via plugin-root",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/dump.mjs\" --host codex --event SessionStart --via claude-root",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/dump.mjs\" --host codex --event SessionStart --via plugin-env",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/dump.mjs\" --host codex --event PreToolUse --via plugin-root --role pre",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/dump.mjs\" --host codex --event PostToolUse --via plugin-root",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/dump.mjs\" --host codex --event SubagentStart --via plugin-root",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/dump.mjs\" --host codex --event SubagentStop --via plugin-root",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/dump.mjs\" --host codex --event UserPromptSubmit --via plugin-root",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/dump.mjs\" --host codex --event Stop --via plugin-root --role stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
