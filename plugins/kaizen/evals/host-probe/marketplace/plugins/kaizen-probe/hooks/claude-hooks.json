{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/dump.mjs\" --host claude --event SessionStart --via claude-root",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT/scripts/dump.mjs\" --host claude --event SessionStart --via claude-env",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/dump.mjs\" --host claude --event SessionStart --via plugin-root",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/dump.mjs\" --host claude --event PreToolUse --via claude-root --role pre",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/dump.mjs\" --host claude --event PostToolUse --via claude-root",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/dump.mjs\" --host claude --event SubagentStart --via claude-root",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/dump.mjs\" --host claude --event SubagentStop --via claude-root",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/dump.mjs\" --host claude --event UserPromptSubmit --via claude-root",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/dump.mjs\" --host claude --event Stop --via claude-root --role stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
