 "narration": "narration.wav",
 "lines": [
  {
   "id": "titre",
   "text": "This is Kioku. In Japanese, the word means memory.",
   "start": 1.6,
   "end": 4.709,
   "file": "line-01-00672e13.wav"
  },
  {
   "id": "probleme",
   "text": "At work, meetings, documents and decisions pile up, and what matters ends up lost.",
   "start": 8.309,
   "end": 13.577,
   "file": "line-02-7ce93638.wav"
  },
  {
   "id": "wiki",
   "text": "Kioku gathers everything into a personal wiki: one page per project, per person, per meeting and per decision.",
   "start": 16.477,
   "end": 23.676,
   "file": "line-03-eb3516d2.wav"
  },
  {
   "id": "claude",
   "text": "Claude writes these pages and keeps them up to date, from the sources you hand it.",
   "start": 26.576,
   "end": 30.761,
   "file": "line-04-6dbe33cc.wav"
  },
  {
   "id": "question",
   "text": "Then you simply ask a question. The answer comes from the wiki, with its sources.",
   "start": 33.661,
   "end": 38.084,
   "file": "line-05-ea8a6c0f.wav"
  },
  {
   "id": "chemin",
   "text": "Every piece of information follows the same path, through three layers: bronze, silver and gold. This is the medallion architecture.",
   "start": 40.984,
   "end": 49.401,
   "file": "line-06-42d3c363.wav"
  },
  {
   "id": "gate",
   "text": "To reach the gold layer, a page must pass a gate.",
   "start": 52.301,
   "end": 55.207,
   "file": "line-07-b801a101.wav"
  },
  {
   "id": "relecteur",
   "text": "An independent reviewer checks where it comes from, its format, and respect for the people it mentions.",
   "start": 58.107,
   "end": 63.861,
   "file": "line-08-bc2b6699.wav"
  },
  {
   "id": "quarantaine",
   "text": "Whatever it holds back is set aside, and waits for a human decision.",
   "start": 66.761,
   "end": 70.537,
   "file": "line-09-dce4f66d.wav"
  },
  {
   "id": "silo",
   "text": "Each domain, work or personal life for example, lives in its own silo, with its own reviewer and its own rules.",
   "start": 73.937,
   "end": 80.988,
   "file": "line-10-5499e150.wav"
  },
  {
   "id": "graphe",
   "text": "A local dashboard shows the whole wiki as a 3D graph: every page is a point, linked to the pages it cites.",
   "start": 84.388,
   "end": 91.502,
   "file": "line-11-1666553d.wav"
  },
  {
   "id": "conclusion",
   "text": "Kioku. A working memory that no longer gets lost: reviewed, sourced, and always one question away.",
   "start": 94.403,
   "end": 100.949,
   "file": "line-12-4fde7beb.wav"
  }
 ],
